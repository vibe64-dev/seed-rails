<section class="card">
  <%= form_with model: @note, url: notes_path, class: "note-form" do |form| %>
    <%= form.label :body, "New note" %>
    <%= form.text_area :body, rows: 3, maxlength: 500, required: true, placeholder: "Write something worth keeping" %>
    <% @note.errors.full_messages.each do |message| %>
      <p class="error"><%= message %></p>
    <% end %>
    <%= form.submit "Save note" %>
  <% end %>
</section>

<section aria-label="Notes">
  <% if @notes.empty? %>
    <p class="muted">No notes yet. Saved notes appear here.</p>
  <% else %>
    <ul class="notes">
      <% @notes.each do |note| %>
        <li>
          <p><%= note.body %></p>
          <time datetime="<%= note.created_at.iso8601 %>"><%= l note.created_at, format: :short %></time>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
